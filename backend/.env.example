# ============================================================
# WalkMate Backend — Environment Variables
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.
# ============================================================

# ── Database (Supabase / PostgreSQL) ─────────────────────────
DB_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<supabase-db-password>

# ── JWT ───────────────────────────────────────────────────────
# Must be at least 32 characters for HS256.
JWT_SECRET=<minimum-32-char-secret>
# Optional — defaults shown below.
# JWT_ACCESS_TOKEN_TTL_SECONDS=900
# JWT_REFRESH_TOKEN_TTL_SECONDS=2592000

# ── MongoDB Atlas (Chat) ──────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=WalkMate

# ── Gmail SMTP (Forgot-Password OTP emails) ───────────────────
# Use a Gmail App Password, not your account password.
# How to create one: Google Account → Security → 2-Step Verification → App passwords
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx
# Optional overrides (defaults are smtp.gmail.com:587):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
