# ============================================================
# WalkMate Backend — Environment Variables
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.
# ============================================================

# ── Database (Neon / Supabase / PostgreSQL) ───────────────────
# Option 1 (Neon): paste the connection string from the Neon Console as-is.
# Credentials in the URL win over DB_USERNAME/DB_PASSWORD, so those can stay empty.
# The backend converts it to JDBC, drops channel_binding and adds sslmode=require.
DB_URL=postgresql://<user>:<password>@<endpoint>.neon.tech/<database>?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# Option 2: any PostgreSQL reachable through a JDBC URL.
# DB_URL=jdbc:postgresql://<host>:5432/<database>?sslmode=require
# DB_USERNAME=<user>
# DB_PASSWORD=<password>

# ── JWT ───────────────────────────────────────────────────────
# Must be at least 32 characters for HS256.
JWT_SECRET=<minimum-32-char-secret>
# Optional — defaults shown below.
# JWT_ACCESS_TOKEN_TTL_SECONDS=900
# JWT_REFRESH_TOKEN_TTL_SECONDS=2592000

# ── MongoDB Atlas (Chat) ──────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=WalkMate

# ── Firebase Admin SDK (Google Sign-In + FCM) ─────────────────
# Required at startup. Paste the full service-account JSON on a single line.
# Alternative for local dev: place the file at
# backend/src/main/resources/firebase-service-account.json (git-ignored).
FIREBASE_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# ── Gmail SMTP (Forgot-Password OTP emails) ───────────────────
# Use a Gmail App Password, not your account password.
# How to create one: Google Account → Security → 2-Step Verification → App passwords
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx
# Optional overrides (defaults are smtp.gmail.com:587):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587

# Cloudinary (Avatar Upload)
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>
