<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Required to call startForeground() from a Service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <!-- Required for targetSdk >= 34 when foregroundServiceType="location" -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <!-- Required for API 33+ to post the persistent tracking notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:name=".WalkMateApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.WalkMate">
        <activity
            android:name="com.walkmate.ui.auth.AuthActivity"
            android:theme="@style/Theme.WalkMate"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.walkmate.ui.auth.register.RegisterActivity"
            android:theme="@style/Theme.WalkMate"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.walkmate.ui.main.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.WalkMate">
        </activity>

        <!-- Registered here; fully wired in Phase 3 (Entry-Point) -->
        <activity
            android:name="com.walkmate.ui.tracking.TrackingScreenActivity"
            android:exported="false"
            android:theme="@style/Theme.WalkMate" />

        <!-- GPS foreground service; foregroundServiceType required for targetSdk >= 34 -->
        <service
            android:name="com.walkmate.service.WalkTrackerService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

    </application>

</manifest>