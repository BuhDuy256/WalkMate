<?xml version="1.0" encoding="utf-8"?>
<!--
    Converted from: src/styles/fonts.css
    Place at:       app/src/main/res/font/nunito.xml

    Matches: Nunito weights 300, 400, 500, 600, 700, 800, 900
             + italic 400 (as used in fonts.css Google Fonts import)

    HOW TO ADD THE ACTUAL FONT FILES:
    Option A — Downloadable Fonts (recommended, no APK size increase):
      1. In Android Studio: res/font → right-click → New → Font resource file
      2. Choose "Downloadable font" and search "Nunito"
      3. Android Studio generates this file automatically via Google Fonts provider

    Option B — Bundled font files (offline support):
      1. Download Nunito .ttf files from fonts.google.com
      2. Place them in app/src/main/res/font/ e.g.:
           nunito_regular.ttf
           nunito_medium.ttf
           nunito_semibold.ttf
           nunito_bold.ttf
           nunito_italic.ttf
      3. Reference them in the <font> entries below (swap app:font= paths)
-->
<font-family xmlns:app="http://schemas.android.com/apk/res-auto"
    app:fontProviderAuthority="com.google.android.gms.fonts"
    app:fontProviderPackage="com.google.android.gms"
    app:fontProviderQuery="Nunito"
    app:fontProviderCerts="@array/com_google_android_gms_fonts_certs">
    <!--
        When using bundled .ttf files instead, replace the above attributes with:
        xmlns:android="http://schemas.android.com/apk/res/android"
        and add individual <font> tags:

        <font
            android:fontStyle="normal"
            android:fontWeight="300"
            android:font="@font/nunito_light" />
        <font
            android:fontStyle="normal"
            android:fontWeight="400"
            android:font="@font/nunito_regular" />
        <font
            android:fontStyle="italic"
            android:fontWeight="400"
            android:font="@font/nunito_italic" />
        <font
            android:fontStyle="normal"
            android:fontWeight="500"
            android:font="@font/nunito_medium" />
        <font
            android:fontStyle="normal"
            android:fontWeight="600"
            android:font="@font/nunito_semibold" />
        <font
            android:fontStyle="normal"
            android:fontWeight="700"
            android:font="@font/nunito_bold" />
        <font
            android:fontStyle="normal"
            android:fontWeight="800"
            android:font="@font/nunito_extrabold" />
        <font
            android:fontStyle="normal"
            android:fontWeight="900"
            android:font="@font/nunito_black" />
    -->
</font-family>
