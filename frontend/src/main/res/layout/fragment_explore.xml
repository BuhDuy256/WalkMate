<?xml version="1.0" encoding="utf-8" ?>
<!--
    Tab 1: Explore.

    Layer order (bottom → top):
      1. mapContainer     — Google Map, edge-to-edge
      2. dimOverlay       — reserved, always GONE in the new design
      3. topBar           — Logo pill + Profile avatar, floats above everything
      4. bottomSheet      — BottomSheetBehavior-driven NestedScrollView:
            4a. welcomeContent  — WELCOME state: greeting + search + hotspot chips
            4b. setupContent    — SETUP state: Create Intent form
      5. Scanning floating card — added in Phase B6
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/exploreRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream"
>

    <!-- ================================================================ -->
    <!-- LAYER 1: Google Map                                               -->
    <!-- ================================================================ -->
    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
    />

    <!-- Dim overlay — always GONE; kept for potential future use -->
    <View
        android:id="@+id/dimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay_dim"
        android:elevation="4dp"
        android:visibility="gone"
    />

    <!-- ================================================================ -->
    <!-- LAYER 2: Top Bar                                                  -->
    <!-- ================================================================ -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="48dp"
    >

        <FrameLayout
            android:id="@+id/btnBackToHome"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_map_overlay_btn"
            android:elevation="4dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_back"
                android:tint="@color/text_dark" />
        </FrameLayout>

    </LinearLayout>

    <!-- ================================================================ -->
    <!-- LAYER 3: Unified Bottom Sheet                                     -->
    <!--                                                                   -->
    <!-- BottomSheetBehavior settings:                                     -->
    <!--   peekHeight   = 280dp  → shows welcome content in COLLAPSED state -->
    <!--   hideable     = false  → sheet is always on screen               -->
    <!--   skipCollapsed= false  → drag from EXPANDED returns to COLLAPSED  -->
    <!--   fitToContents= true   → EXPANDED fills available screen height  -->
    <!-- ================================================================ -->
    <LinearLayout
        android:id="@+id/bottomSheetContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_sheet_top_rounded"
        android:elevation="6dp"
        app:behavior_fitToContents="true"
        app:behavior_hideable="false"
        app:behavior_peekHeight="280dp"
        app:behavior_skipCollapsed="false"
        app:layout_behavior="com.walkmate.ui.explore.HandleOnlyBottomSheetBehavior"
    >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/dragHandleArea"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@android:color/transparent"
        >
            <View
                android:id="@+id/handleBackground"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_handle_target"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.9"
            />

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:background="@drawable/bg_handle_bar"
                android:alpha="0.5"
                app:layout_constraintBottom_toBottomOf="@id/handleBackground"
                app:layout_constraintEnd_toEndOf="@id/handleBackground"
                app:layout_constraintStart_toStartOf="@id/handleBackground"
                app:layout_constraintTop_toTopOf="@id/handleBackground"
            />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/bottomSheetScrollContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:elevation="0dp"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingBottom="20dp"
            android:overScrollMode="never"
        >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="0dp"
            >

                <!--
                    Drag-handle touch area.
                    The FrameLayout provides a generous 36 dp tap / drag target
                    while the visual bar remains the small 40×4 dp pill.
                    HandleOnlyBottomSheetBehavior checks this view's rect, so
                    dragging the sheet is only possible when the finger starts here.
                -->

                <!-- ============================================================ -->
                <!-- 4a. WELCOME CONTENT                                          -->
                <!-- Visible in WELCOME state; hidden in SETUP / SCANNING         -->
                <!-- ============================================================ -->
                <LinearLayout
                    android:id="@+id/welcomeContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="4dp"
                    android:visibility="visible"
                >

                    <TextView
                        android:id="@+id/txtWelcomeGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ready to walk? 🚶"
                        android:textColor="@color/text_dark"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="-0.012"
                    />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Pick a hotspot to get started"
                        android:textColor="@color/text_muted"
                        android:textSize="14sp"
                    />

                    <!-- Contextual guidance banner — appears when a friend is pre-selected
                         from FriendsFragment. Hidden by default; shown via Java when
                         CreateIntentViewModel carries a private + friend selection. -->
                    <LinearLayout
                        android:id="@+id/bannerInviteFriend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_field_outlined"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📍"
                            android:textSize="15sp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/txtInviteBannerMessage"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/text_dark"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <!-- Search bar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/bg_search_bar"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:layout_marginEnd="10dp"
                            android:src="@drawable/ic_search" />

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/searchInputEdit"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:hint="@string/search_place_hint"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:maxLines="1"
                            android:paddingBottom="0dp"
                            android:paddingTop="0dp"
                            android:textColor="@color/text_dark"
                            android:textColorHint="@color/text_muted"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <!-- Search results — shown only when query is non-empty -->
                    <LinearLayout
                        android:id="@+id/searchResultsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="4dp"
                        android:visibility="gone"
                    />

                    <!-- Popular spots section — hidden while a search query is active -->
                    <LinearLayout
                        android:id="@+id/popularSpotsSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="8dp"
                    >
                        <!-- Hotspot chips — populated dynamically from ViewModel state -->
                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:scrollbars="none"
                        >
                            <LinearLayout
                                android:id="@+id/chipGroupHotspots"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingEnd="8dp"
                            />
                        </HorizontalScrollView>
                    </LinearLayout>
                </LinearLayout>

                <!-- ============================================================ -->
                <!-- 4b. SETUP CONTENT — Create Intent Form                       -->
                <!-- Visible in SETUP state; hidden in WELCOME / SCANNING         -->
                <!-- Form fields match fragment_create_intent.xml IDs so existing -->
                <!-- Java helper logic transfers without changes.                  -->
                <!-- ============================================================ -->
                <LinearLayout
                    android:id="@+id/setupContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="26dp"
                    android:visibility="gone"
                >

                    <!-- Header: selected hotspot name -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/section_gap"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                    >

                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_icon_container_orange"
                        >

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_hotspot_pin"
                                app:tint="@color/orange_primary" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical"
                        >

                            <TextView
                                android:id="@+id/txtSetupHotspotName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_dark"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:letterSpacing="-0.012"
                            />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/set_preferences_title"
                                android:textColor="@color/orange_primary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                            />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- SECTION: Date -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="DATE"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                    />

                    <!-- Date picker row: shows current date, tap to open DatePickerDialog -->
                    <LinearLayout
                        android:id="@+id/rowDatePicker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_date_picker_orange"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <FrameLayout
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:background="@drawable/bg_gradient_button">

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_history"
                                app:tint="@color/white" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/txtSelectedDate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="2026-04-01"
                            android:textColor="@color/orange_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Change"
                            android:textColor="@color/orange_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- SECTION: Time -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/section_gap"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                    >
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="TIME WINDOW"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                        />
                        <!-- Live time-range badge (values updated by slider listener) -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_icon_container_orange"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/txtTimeStart"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="16:00"
                                android:textColor="@color/orange_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                            />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" – "
                                android:textColor="@color/orange_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                            />
                            <TextView
                                android:id="@+id/txtTimeEnd"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="22:00"
                                android:textColor="@color/orange_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                            />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.slider.RangeSlider
                        android:id="@+id/sliderTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="0.5"
                        android:valueFrom="6.0"
                        android:valueTo="24.0"
                        app:haloColor="@color/color_orange_halo"
                        app:thumbColor="@color/white"
                        app:thumbRadius="10dp"
                        app:thumbStrokeColor="@color/orange_primary"
                        app:thumbStrokeWidth="2dp"
                        app:trackColorActive="@color/orange_primary"
                        app:trackColorInactive="@color/slider_track_inactive"
                        app:trackHeight="6dp"
                    />

                    <!-- Public-only preference fields (Age / Gender / Tags).
                         When Private Walk is ON, this container is dimmed and
                         interaction is blocked in ExploreFragment. -->
                    <LinearLayout
                        android:id="@+id/layoutPublicOptions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                    <!-- SECTION: Age -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/section_gap"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                    >
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="AGE RANGE"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                        />
                        <!-- Live age-range badge (values updated by slider listener) -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_icon_container_orange"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/txtAgeMin"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="18"
                                android:textColor="@color/orange_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                            />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" – "
                                android:textColor="@color/orange_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                            />
                            <TextView
                                android:id="@+id/txtAgeMax"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="40"
                                android:textColor="@color/orange_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                            />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.slider.RangeSlider
                        android:id="@+id/sliderAge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="1.0"
                        android:valueFrom="16.0"
                        android:valueTo="65.0"
                        app:haloColor="@color/color_orange_halo"
                        app:thumbColor="@color/white"
                        app:thumbRadius="10dp"
                        app:thumbStrokeColor="@color/orange_primary"
                        app:thumbStrokeWidth="2dp"
                        app:trackColorActive="@color/orange_primary"
                        app:trackColorInactive="@color/slider_track_inactive"
                        app:trackHeight="6dp"
                    />

                    <!-- SECTION: Gender -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/section_gap"
                        android:text="PREFERRED GENDER"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                    />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupGender"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:chipSpacingHorizontal="8dp"
                        app:singleSelection="true"
                    >

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipMale"
                            style="@style/Widget.WalkMate.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/gender_male"
                        />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFemale"
                            style="@style/Widget.WalkMate.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/gender_female"
                        />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipAny"
                            style="@style/Widget.WalkMate.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/gender_any"
                        />
                    </com.google.android.material.chip.ChipGroup>

                    </LinearLayout>
                    <!-- end layoutPublicOptions -->

                    <!-- Hint shown when private mode is ON (sits below the dimmed block) -->
                    <TextView
                        android:id="@+id/txtPrivateModeHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_field_outlined"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:text="🔒  Age, Gender and Tags are not used for private walks"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <!-- Private Walk toggle row -->
                    <LinearLayout
                        android:id="@+id/rowPrivateWalk"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_icon_container_orange">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_lock"
                                app:tint="@color/orange_primary" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/private_walk"
                                android:textColor="@color/text_dark"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Invite a friend directly"
                                android:textColor="@color/text_muted"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchPrivateWalk"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                    <!-- Friend picker row (visible only when switchPrivateWalk is ON) -->
                    <LinearLayout
                        android:id="@+id/rowFriendPicker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_field_outlined"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="👤"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="@string/invite_friend"
                            android:textColor="@color/text_muted"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/txtSelectedFriend"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableEnd="@drawable/ic_chevron_right"
                            android:drawablePadding="4dp"
                            android:text="@string/select_friend"
                            android:textColor="@color/orange_start"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <!-- Validation error for private intent config -->
                    <TextView
                        android:id="@+id/txtPrivateIntentError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/color_danger"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <!-- CTA -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFindMatch"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height_large"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_gradient_orange_pill"
                        android:stateListAnimator="@null"
                        android:text="@string/find_match"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null"
                        app:cornerRadius="999dp"
                    />

                </LinearLayout>

                <!-- ============================================================ -->
                <!-- 4c. SCANNING CONTENT                                         -->
                <!-- Visible in SCANNING state; hidden in WELCOME / SETUP         -->
                <!-- ============================================================ -->
                <LinearLayout
                    android:id="@+id/scanningContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="80dp"
                    android:visibility="gone"
                >

                    <!-- Header: hotspot being scanned -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                    >

                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_icon_container_orange"
                        >

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_hotspot_pin"
                                app:tint="@color/orange_primary" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/txtScanningHotspotName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:textColor="@color/text_dark"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:letterSpacing="-0.012"
                        />
                    </LinearLayout>

                    <!-- Spinner -->
                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        app:indicatorColor="@color/orange_primary"
                        app:indicatorSize="56dp"
                        app:trackColor="@color/slider_track_inactive"
                    />

                    <!-- Status text -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/scanning_status"
                        android:textColor="@color/text_dark"
                        android:textSize="16sp"
                        android:textStyle="bold"
                    />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/scanning_subtitle"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp"
                    />

                    <!-- CTA: Stop Searching -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStopSearching"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height_large"
                        android:layout_marginTop="24dp"
                        android:text="@string/btn_stop_searching"
                        android:textAllCaps="false"
                        android:textColor="@color/orange_primary"
                        android:textSize="15sp"
                        app:cornerRadius="999dp"
                        app:strokeColor="@color/orange_primary"
                    />

                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
