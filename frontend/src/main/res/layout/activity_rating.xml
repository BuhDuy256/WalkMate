<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/rating_bg_warm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/ic_rating_arrow_back"
                android:padding="8dp"
                android:background="@drawable/bg_rating_chip_soft_beige"
                android:contentDescription="Back"
                android:layout_marginStart="-8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rate Your Walk"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/rating_text_primary"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="How was the experience?"
            android:textSize="14sp"
            android:textColor="@color/rating_text_secondary"
            android:layout_marginStart="40dp"
            android:layout_marginBottom="16dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardElevation="5dp"
            app:cardCornerRadius="26dp"
            app:cardBackgroundColor="@color/rating_card_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/iv_partner_avatar"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/rating_avatar_placeholder"
                        app:civ_border_width="0dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:id="@+id/tv_partner_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sophia K."
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/rating_text_primary" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="4dp">

                            <TextView
                                android:id="@+id/tv_duration"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="32 min"
                                android:textSize="13sp"
                                android:textColor="@color/rating_text_secondary" />

                            <View
                                android:layout_width="4dp"
                                android:layout_height="4dp"
                                android:background="@drawable/bg_rating_dot_divider"
                                android:layout_marginHorizontal="8dp" />

                            <TextView
                                android:id="@+id/tv_distance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1.2 km"
                                android:textSize="13sp"
                                android:textColor="@color/rating_text_secondary" />

                            <View
                                android:layout_width="4dp"
                                android:layout_height="4dp"
                                android:background="@drawable/bg_rating_dot_divider"
                                android:layout_marginHorizontal="8dp" />

                            <TextView
                                android:id="@+id/tv_steps"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1,580 steps"
                                android:textSize="13sp"
                                android:textColor="@color/rating_text_secondary" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:id="@+id/tv_walk_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Walk Completed"
                        android:textSize="12sp"
                        android:textColor="@color/rating_accent_strong"
                        android:background="@drawable/bg_rating_chip_soft_orange"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tv_walk_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="04 MAR"
                        android:textSize="12sp"
                        android:textColor="@color/rating_text_muted" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardElevation="6dp"
            app:cardCornerRadius="28dp"
            app:cardBackgroundColor="@color/rating_card_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/tv_rating_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Great time!"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/rating_text_primary"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/tv_rating_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="You had a solid walk"
                    android:textSize="14sp"
                    android:textColor="@color/rating_text_secondary"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:gravity="center" />

                <LinearLayout
                    android:id="@+id/star_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/star_1"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_rating_star_filled"
                        android:padding="2dp"
                        android:contentDescription="Star 1" />

                    <ImageView
                        android:id="@+id/star_2"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_rating_star_filled"
                        android:padding="2dp"
                        android:contentDescription="Star 2" />

                    <ImageView
                        android:id="@+id/star_3"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_rating_star_filled"
                        android:padding="2dp"
                        android:contentDescription="Star 3" />

                    <ImageView
                        android:id="@+id/star_4"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_rating_star_filled"
                        android:padding="2dp"
                        android:contentDescription="Star 4" />

                    <ImageView
                        android:id="@+id/star_5"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_rating_star_outline"
                        android:padding="2dp"
                        android:contentDescription="Star 5" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="@color/rating_card_surface"
            app:cardCornerRadius="28dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="What stood out? ☀️"
                        android:textColor="@color/rating_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_rating_chip_soft_orange"
                        android:paddingStart="12dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="5dp"
                        android:text="Selected"
                        android:textColor="@color/rating_accent_strong"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="10dp"
                    android:text="Select all that apply"
                    android:textColor="@color/rating_text_secondary"
                    android:textSize="12sp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_tags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="10dp"
                    app:singleSelection="false" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardElevation="6dp"
            app:cardCornerRadius="28dp"
            app:cardBackgroundColor="@color/rating_card_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💬  Leave a note (optional)"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/rating_text_primary"
                    android:layout_marginBottom="10dp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="0dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundColor="@color/rating_input_surface"
                        app:boxBackgroundMode="filled"
                        app:boxCollapsedPaddingTop="0dp"
                        app:boxCornerRadiusBottomEnd="18dp"
                        app:boxCornerRadiusBottomStart="18dp"
                        app:boxCornerRadiusTopEnd="18dp"
                        app:boxCornerRadiusTopStart="18dp"
                        app:boxStrokeWidth="0dp"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_comment"
                            android:layout_width="match_parent"
                            android:layout_height="100dp"
                            android:gravity="top|start"
                            android:hint="Tell Sophia what made the walk special..."
                            android:inputType="textMultiLine"
                            android:maxLength="200"
                            android:background="@android:color/transparent"
                            android:padding="14dp"
                            android:textColor="@color/rating_text_primary"
                            android:textColorHint="@color/rating_text_muted" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/tv_char_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0/200"
                        android:textSize="12sp"
                        android:textColor="@color/rating_accent_soft"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="12dp"
                        android:layout_marginBottom="8dp" />
                </FrameLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/rating_card_surface"
            app:cardCornerRadius="28dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏅  Your Badges"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/rating_text_primary" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 earned"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:textColor="@color/rating_accent_strong"
                        android:paddingStart="11dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="11dp"
                        android:paddingBottom="5dp"
                        android:background="@drawable/bg_rating_chip_soft_orange" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/badges_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="12dp">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp">

                        <View
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_rating_badge_earned_orange" />

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_rating_badge_walk" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="First Walk"
                        android:textSize="11sp"
                        android:textColor="@color/rating_text_primary"
                        android:gravity="center"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="12dp">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp">

                        <View
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_rating_badge_earned_yellow" />

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_rating_badge_star" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reviewer"
                        android:textSize="11sp"
                        android:textColor="@color/rating_text_primary"
                        android:gravity="center"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="12dp">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp">

                        <View
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_rating_badge_earned_mint" />

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_rating_badge_group" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3"
                            android:textSize="10sp"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:background="@drawable/bg_rating_badge_count"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            android:layout_gravity="top|end" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Buddy Up"
                        android:textSize="11sp"
                        android:textColor="@color/rating_text_primary"
                        android:gravity="center"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="12dp"
                    android:alpha="0.52">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp">

                        <View
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_rating_badge_locked" />

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_rating_badge_plus" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5 Walks"
                        android:textSize="11sp"
                        android:textColor="@color/rating_text_secondary"
                        android:gravity="center"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:alpha="0.52">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp">

                        <View
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_rating_badge_locked" />

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_rating_badge_clock" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Streak"
                        android:textSize="11sp"
                        android:textColor="@color/rating_text_secondary"
                        android:gravity="center"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tv_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/rating_error"
            android:textSize="14sp"
            android:visibility="gone"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_submit"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="✨  Submit Rating"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_rating_submit_button"
            android:elevation="4dp"
            app:backgroundTint="@null"
            app:cornerRadius="29dp" />

        <TextView
            android:id="@+id/tv_maybe_later"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Maybe later"
            android:textSize="14sp"
            android:textColor="@color/rating_text_secondary"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>