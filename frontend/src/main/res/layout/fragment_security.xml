<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_cream">

    <include layout="@layout/layout_sub_page_header" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="32dp">

            <!-- ── Login Methods card ─────────────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/bg_white"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="10dp"
                        android:text="@string/security_section_login_methods"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:textColor="@color/text_muted"
                        android:letterSpacing="0.12" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/card_border" />

                    <!-- Password row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="13dp"
                        android:paddingBottom="13dp">

                        <FrameLayout
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_security_icon_orange"
                            android:layout_marginEnd="12dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_lock"
                                android:tint="@color/orange_primary"
                                android:contentDescription="@string/security_label_password" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/security_label_password"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_dark" />

                        <TextView
                            android:id="@+id/txtPasswordStatusPill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/card_border" />

                    <!-- Google row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="13dp"
                        android:paddingBottom="13dp">

                        <FrameLayout
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_security_icon_green"
                            android:layout_marginEnd="12dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_google"
                                android:contentDescription="@string/security_label_google" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/security_label_google"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_dark" />

                        <TextView
                            android:id="@+id/txtGoogleStatusPill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── Change Password card ───────────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/bg_white"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Section header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="10dp">

                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:src="@drawable/ic_lock"
                            android:tint="@color/orange_primary"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/security_section_change_password"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textAllCaps="true"
                            android:textColor="@color/text_muted"
                            android:letterSpacing="0.12" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/card_border" />

                    <!-- Form fields -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="18dp"
                        android:paddingBottom="20dp">

                        <!-- Current Password (hidden when no existing password) -->
                        <LinearLayout
                            android:id="@+id/rowCurrentPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <com.walkmate.core.designsystem.view.WalkMateInputField
                                android:id="@+id/fieldCurrentPassword"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="14dp"
                                app:wm_label="@string/security_field_current_password"
                                app:wm_hint="@string/security_field_current_password"
                                app:wm_inputType="textPassword"
                                app:wm_passwordToggle="true" />

                        </LinearLayout>

                        <!-- New Password -->
                        <com.walkmate.core.designsystem.view.WalkMateInputField
                            android:id="@+id/fieldNewPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            app:wm_label="@string/security_field_new_password"
                            app:wm_hint="@string/security_field_new_password"
                            app:wm_inputType="textPassword"
                            app:wm_passwordToggle="true" />

                        <!-- Password strength bar -->
                        <LinearLayout
                            android:id="@+id/rowStrengthBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginBottom="14dp"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="5dp">

                                <View
                                    android:id="@+id/strengthBar1"
                                    android:layout_width="0dp"
                                    android:layout_height="3dp"
                                    android:layout_weight="1"
                                    android:background="@color/card_border"
                                    android:layout_marginEnd="4dp" />

                                <View
                                    android:id="@+id/strengthBar2"
                                    android:layout_width="0dp"
                                    android:layout_height="3dp"
                                    android:layout_weight="1"
                                    android:background="@color/card_border"
                                    android:layout_marginEnd="4dp" />

                                <View
                                    android:id="@+id/strengthBar3"
                                    android:layout_width="0dp"
                                    android:layout_height="3dp"
                                    android:layout_weight="1"
                                    android:background="@color/card_border" />

                            </LinearLayout>

                            <TextView
                                android:id="@+id/txtStrengthLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- Confirm New Password -->
                        <com.walkmate.core.designsystem.view.WalkMateInputField
                            android:id="@+id/fieldConfirmPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="20dp"
                            app:wm_label="@string/security_field_confirm_password"
                            app:wm_hint="@string/security_field_confirm_password"
                            app:wm_inputType="textPassword"
                            app:wm_passwordToggle="true" />

                        <com.walkmate.core.designsystem.view.WalkMateButton
                            android:id="@+id/btnSavePassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:wm_text="@string/security_btn_set_password"
                            app:wm_buttonStyle="filled" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── Security tip card ──────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_security_tip"
                android:padding="14dp"
                android:layout_marginTop="16dp"
                android:gravity="top">

                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_security_tip_icon"
                    android:layout_marginEnd="12dp">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_trust_shield"
                        android:tint="@color/orange_primary"
                        android:contentDescription="@null" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/security_tip_title"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#9A3412"
                        android:layout_marginBottom="3dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/security_tip_body"
                        android:textSize="12sp"
                        android:textColor="#C2410C"
                        android:lineSpacingMultiplier="1.5" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
