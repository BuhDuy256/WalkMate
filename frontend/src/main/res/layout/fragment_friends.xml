<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_cream">

    <!-- ── Sticky header ──────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bg_white"
        android:elevation="4dp">

        <include layout="@layout/layout_sub_page_header" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayoutFriends"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabMode="fixed"
            app:tabGravity="fill"
            app:tabSelectedTextColor="@color/orange_primary"
            app:tabTextColor="@color/text_muted"
            app:tabIndicatorColor="@color/orange_primary"
            app:tabIndicatorHeight="2.5dp"
            app:tabIndicatorFullWidth="false"
            app:tabBackground="@android:color/transparent" />

        <!-- 1dp bottom border under tabs -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F3F2F0" />

    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerFriends"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
