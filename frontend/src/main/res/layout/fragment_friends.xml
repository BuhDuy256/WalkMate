<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_cream">

    <!-- ── Header row: back button inline with tabs ──────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg_white"
        android:elevation="4dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp">

        <ImageButton
            android:id="@+id/btnSubPageBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_btn_back"
            android:src="@drawable/ic_back"
            android:padding="8dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="6dp"
            android:contentDescription="Back" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayoutFriends"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:tabMode="fixed"
            app:tabGravity="fill"
            app:tabSelectedTextColor="@color/orange_primary"
            app:tabTextColor="@color/text_muted"
            app:tabIndicatorColor="@color/orange_primary"
            app:tabIndicatorHeight="2.5dp"
            app:tabTextAppearance="@style/FriendsTabTextAppearance" />

    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerFriends"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
