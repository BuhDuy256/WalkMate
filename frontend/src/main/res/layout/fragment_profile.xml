<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream"
    tools:context=".ui.profile.ProfileFragment">

    <!-- Loading state overlay -->
    <ProgressBar
        android:id="@+id/progressProfile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Scrollable content container -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/profileScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_cream"
        android:overScrollMode="never">

        <!-- Root vertical stack for profile content -->
        <LinearLayout
            android:id="@+id/profileContentRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── HEADER ──────────────────────────────────────────────────────── -->
            <!-- Top bar wrapper -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="52dp"
                android:paddingBottom="16dp">

                <!-- Left spacer to balance title centering -->
                <Space
                    android:id="@+id/spaceStart"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <!-- Screen title -->
                <TextView
                    android:id="@+id/txtProfileScreenTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_screen_title"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_dark"
                    android:letterSpacing="-0.02"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />


            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ── IDENTITY ──────────────────────────────────────────────────────── -->
            <!-- Identity section: avatar + name + actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="20dp">

                <!-- Avatar -->
                <ImageView
                    android:id="@+id/imgProfileAvatar"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/bg_white_circle"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/profile_avatar_cd"
                    tools:src="@drawable/ic_user" />

                <!-- Full name -->
                <TextView
                    android:id="@+id/txtProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_dark"
                    android:gravity="center"
                    android:letterSpacing="-0.02"
                    tools:text="Luân Trần" />

                <!-- View as Public Profile -->
                <!-- Public profile shortcut -->
                <LinearLayout
                    android:id="@+id/btnViewPublicProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:src="@drawable/ic_eye_show"
                        android:layout_marginEnd="5dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_view_public"
                        android:textSize="13sp"
                        android:textColor="@color/text_label"
                        android:fontFamily="sans-serif-medium" />

                </LinearLayout>

                <!-- Trust score chip: orange border pill -->
                <!-- Trust score indicator -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTrustScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:chipBackgroundColor="@color/bg_white"
                    app:chipStrokeColor="@color/orange_primary"
                    app:chipStrokeWidth="1.5dp"
                    app:chipCornerRadius="50dp"
                    tools:text="⭐ 530 pts" />

                <!-- Trust tier label -->
                <!-- Trust tier label -->
                <TextView
                    android:id="@+id/txtTrustTier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_label"
                    tools:text="Standard" />

                <!-- Personality tags -->
                <!-- User tags group -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupTags"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:chipSpacingHorizontal="6dp"
                    app:singleLine="false">

                    <!-- Tag 1 -->
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTag1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/orange_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:chipBackgroundColor="@color/tag_pill_bg"
                        app:chipStrokeColor="@color/tag_pill_border"
                        app:chipStrokeWidth="1.5dp"
                        app:chipCornerRadius="50dp"
                        tools:text="Power Walking"
                        tools:visibility="visible" />

                    <!-- Tag 2 -->
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTag2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/orange_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:chipBackgroundColor="@color/tag_pill_bg"
                        app:chipStrokeColor="@color/tag_pill_border"
                        app:chipStrokeWidth="1.5dp"
                        app:chipCornerRadius="50dp"
                        tools:text="Dog Friendly"
                        tools:visibility="visible" />

                    <!-- Tag 3 -->
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTag3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/orange_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:chipBackgroundColor="@color/tag_pill_bg"
                        app:chipStrokeColor="@color/tag_pill_border"
                        app:chipStrokeWidth="1.5dp"
                        app:chipCornerRadius="50dp"
                        tools:text="Early Bird"
                        tools:visibility="visible" />

                </com.google.android.material.chip.ChipGroup>

                <!-- Edit Profile button: orange gradient pill with pencil icon -->
                <!-- Edit profile CTA -->
                <LinearLayout
                    android:id="@+id/btnEditProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/bg_edit_profile_btn"
                    android:paddingStart="44dp"
                    android:paddingEnd="44dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:layout_marginTop="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_pencil"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Edit Profile"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:letterSpacing="-0.005" />

                </LinearLayout>

            </LinearLayout>

            <!-- ── STATS CARD ────────────────────────────────────────────────────── -->
            <!-- Milestones stats card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMilestones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/bg_white"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1.5dp">

                <!-- Two columns: KM | Sessions -->
                <!-- Two-column stats row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Column 1: Total KM -->
                    <!-- Stat column: total KM -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:paddingTop="20dp"
                        android:paddingBottom="20dp">

                        <!-- Icon container: 36x36, #FFF7ED, 11dp corners -->
                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_icon_container_orange"
                            android:layout_marginBottom="8dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_distance"
                                android:contentDescription="@string/profile_stat_km_cd" />

                        </FrameLayout>

                        <TextView
                            android:id="@+id/txtStatKmValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_dark"
                            android:lineSpacingExtra="0dp"
                            tools:text="0" />

                        <TextView
                            android:id="@+id/txtStatKmLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/profile_stat_total_km"
                            android:textSize="12sp"
                            android:textColor="@color/text_muted"
                            android:fontFamily="sans-serif-medium" />

                    </LinearLayout>

                    <!-- Vertical divider -->
                    <!-- Column divider -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/card_border" />

                    <!-- Column 2: Sessions -->
                    <!-- Stat column: sessions -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:paddingTop="20dp"
                        android:paddingBottom="20dp">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_icon_container_orange"
                            android:layout_marginBottom="8dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_session"
                                android:contentDescription="@string/profile_stat_sessions_cd" />

                        </FrameLayout>

                        <TextView
                            android:id="@+id/txtStatSessionsValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_dark"
                            android:lineSpacingExtra="0dp"
                            tools:text="2" />

                        <TextView
                            android:id="@+id/txtStatSessionsLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/profile_stat_sessions"
                            android:textSize="12sp"
                            android:textColor="@color/text_muted"
                            android:fontFamily="sans-serif-medium" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── MENU CARD (4 rows only) ─────────────────────────────────────── -->
            <!-- Menu card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/bg_white"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1.5dp">

                <!-- Menu rows container -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Row 1: Walk History & Disputes -->
                    <LinearLayout
                        android:id="@+id/menuWalkHistory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="15dp"
                        android:paddingBottom="15dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <FrameLayout
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_menu_icon_container"
                            android:layout_marginEnd="12dp">

                            <ImageView
                                android:layout_width="17dp"
                                android:layout_height="17dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_history"
                                android:contentDescription="@string/profile_menu_walk_history" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/profile_menu_walk_history"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_dark" />

                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:src="@drawable/ic_chevron_right"
                            android:contentDescription="@string/profile_menu_navigate_cd" />

                    </LinearLayout>

                    <!-- Row divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/card_border" />

                    <!-- Row 2: My Badges -->
                    <LinearLayout
                        android:id="@+id/menuMyBadges"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="15dp"
                        android:paddingBottom="15dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <FrameLayout
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_menu_icon_container"
                            android:layout_marginEnd="12dp">

                            <ImageView
                                android:layout_width="17dp"
                                android:layout_height="17dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_badge_first_walk"
                                android:contentDescription="@string/profile_menu_my_badges" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/profile_menu_my_badges"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_dark" />

                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:src="@drawable/ic_chevron_right"
                            android:contentDescription="@string/profile_menu_navigate_cd" />

                    </LinearLayout>

                    <!-- Row divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/card_border" />


                    <!-- Row 4: Friends -->
                    <LinearLayout
                        android:id="@+id/menuFriends"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="15dp"
                        android:paddingBottom="15dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <FrameLayout
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_menu_icon_container"
                            android:layout_marginEnd="12dp">

                            <ImageView
                                android:layout_width="17dp"
                                android:layout_height="17dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_badge_social"
                                android:contentDescription="Friends" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Friends"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_dark" />

                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:src="@drawable/ic_chevron_right"
                            android:contentDescription="@string/profile_menu_navigate_cd" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── LOGOUT CARD ─────────────────────────────────────────────────── -->
            <!-- Security actions card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/bg_white"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1.5dp">

                <!-- Logout action row -->
                <LinearLayout
                    android:id="@+id/btnLogoutAll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="15dp"
                    android:paddingBottom="15dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <FrameLayout
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_logout_icon_container"
                        android:layout_marginEnd="12dp">

                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_logout"
                            android:contentDescription="@string/profile_logout_all" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/profile_logout_all"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_danger" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom spacing to clear nav bar -->
            <Space
                android:id="@+id/bottomSpacer"
                android:layout_width="match_parent"
                android:layout_height="0dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</FrameLayout>






