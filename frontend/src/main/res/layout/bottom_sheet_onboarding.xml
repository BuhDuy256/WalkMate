<?xml version="1.0" encoding="utf-8"?>
<!--
    Onboarding gate bottom sheet.
    Shown when backend returns 403 PROFILE_INCOMPLETE_FOR_MATCHING.
    The user must pick a gender and at least one interest tag to unlock matching.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="32dp">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_sheet_handle" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/onboarding_title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_dark"
        android:layout_marginBottom="6dp" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/onboarding_subtitle"
        android:textSize="13sp"
        android:textColor="@color/text_muted"
        android:layout_marginBottom="24dp" />

    <!-- Gender section label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/onboarding_gender_label"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/text_dark"
        android:layout_marginBottom="10dp" />

    <!-- Gender chips — single selection -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupGender"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:selectionRequired="false"
        app:singleSelection="true"
        app:chipSpacingHorizontal="8dp">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipGenderMale"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Male"
            android:textSize="13sp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipGenderFemale"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Female"
            android:textSize="13sp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipGenderAny"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Any"
            android:textSize="13sp" />

    </com.google.android.material.chip.ChipGroup>

    <!-- Interest tags section label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/onboarding_tags_label"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/text_dark"
        android:layout_marginBottom="10dp" />

    <!-- Tag chips — multi-select, pick at least one -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupTags"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        app:singleSelection="false"
        app:chipSpacingHorizontal="8dp"
        app:chipSpacingVertical="6dp">

        <com.google.android.material.chip.Chip
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Strolling"
            android:textSize="13sp" />

        <com.google.android.material.chip.Chip
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Power Walking"
            android:textSize="13sp" />

        <com.google.android.material.chip.Chip
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Talkative"
            android:textSize="13sp" />

        <com.google.android.material.chip.Chip
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scenic &amp; Quiet"
            android:textSize="13sp" />

        <com.google.android.material.chip.Chip
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pet Friendly"
            android:textSize="13sp" />

    </com.google.android.material.chip.ChipGroup>

    <!-- Inline validation error -->
    <TextView
        android:id="@+id/txtOnboardingError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/color_danger"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone" />

    <!-- Loading indicator (shown while profile is loading or saving) -->
    <ProgressBar
        android:id="@+id/progressOnboarding"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:visibility="gone" />

    <!-- Save button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveOnboarding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/onboarding_btn_save"
        android:textSize="14sp"
        app:cornerRadius="12dp" />

</LinearLayout>
