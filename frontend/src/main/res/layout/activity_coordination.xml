<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream">

    <!-- ========================================================== -->
    <!-- LAYER 1: Fake Map Background                               -->
    <!-- ========================================================== -->
    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_map">

        <!-- Hotspot markers are added programmatically here -->

    </FrameLayout>

    <!-- Dim overlay (shown when sheet/dialog is visible) -->
    <View
        android:id="@+id/dimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay_dim"
        android:visibility="gone"
        android:elevation="4dp" />

    <!-- ========================================================== -->
    <!-- LAYER 2: Top Bar (logo + profile)                          -->
    <!-- ========================================================== -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="48dp"
        android:elevation="8dp">

        <!-- Logo pill -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_white_pill"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚶"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Profile button -->
        <FrameLayout
            android:id="@+id/btnProfile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_white_circle"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="👤"
                android:textSize="16sp" />
        </FrameLayout>
    </LinearLayout>

    <!-- ========================================================== -->
    <!-- LAYER 3: Hotspot Selected CTA Card (bottom)                -->
    <!-- ========================================================== -->
    <LinearLayout
        android:id="@+id/hotspotCtaCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="32dp"
        android:orientation="vertical"
        android:background="@drawable/bg_card_rounded_32"
        android:padding="20dp"
        android:elevation="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Location icon circle -->
            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_warm_circle">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="📍"
                    android:textSize="20sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/txtHotspotName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/walkers_active"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSetIntent"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_medium"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_gradient_orange_pill"
            android:text="@string/set_walking_intent"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            app:backgroundTint="@null"
            app:cornerRadius="999dp" />
    </LinearLayout>

    <!-- ========================================================== -->
    <!-- LAYER 4: Create Intent Bottom Sheet                        -->
    <!-- ========================================================== -->
    <ScrollView
        android:id="@+id/intentSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_sheet_top_rounded"
        android:elevation="12dp"
        android:visibility="gone"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Handle bar -->
            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_handle_bar" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="8dp"
                android:paddingBottom="32dp">

                <!-- Title row with close button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/set_preferences_title"
                        android:textColor="@color/text_dark"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:id="@+id/btnCloseSheet"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_white_circle"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="✕"
                            android:textColor="@color/text_muted"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </FrameLayout>
                </LinearLayout>

                <!-- SECTION: When (Time) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_when_time"
                    android:textColor="@color/text_label"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="20dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/txtTimeStart"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="16:00"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txtTimeEnd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="22:00"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.slider.RangeSlider
                    android:id="@+id/sliderTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="6.0"
                    android:valueTo="24.0"
                    android:stepSize="0.5"
                    app:thumbColor="@color/white"
                    app:thumbStrokeColor="@color/orange_primary"
                    app:thumbStrokeWidth="2dp"
                    app:thumbRadius="10dp"
                    app:trackColorActive="@color/orange_primary"
                    app:trackColorInactive="@color/slider_track_inactive"
                    app:trackHeight="6dp"
                    app:haloColor="#40FF9E67" />

                <!-- SECTION: When (Duration) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_when_duration"
                    android:textColor="@color/text_label"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="20dp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:singleSelection="true"
                    app:chipSpacingHorizontal="8dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipDur15"
                        style="@style/Widget.WalkMate.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dur_15" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipDur30"
                        style="@style/Widget.WalkMate.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dur_30"
                        android:checked="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipDur60"
                        style="@style/Widget.WalkMate.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dur_60" />
                </com.google.android.material.chip.ChipGroup>

                <!-- SECTION: Who (Age) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_who_age"
                    android:textColor="@color/text_label"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="20dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/txtAgeMin"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="18"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txtAgeMax"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="40"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.slider.RangeSlider
                    android:id="@+id/sliderAge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="16.0"
                    android:valueTo="65.0"
                    android:stepSize="1.0"
                    app:thumbColor="@color/white"
                    app:thumbStrokeColor="@color/orange_primary"
                    app:thumbStrokeWidth="2dp"
                    app:thumbRadius="10dp"
                    app:trackColorActive="@color/orange_primary"
                    app:trackColorInactive="@color/slider_track_inactive"
                    app:trackHeight="6dp"
                    app:haloColor="#40FF9E67" />

                <!-- SECTION: Who (Gender) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_who_gender"
                    android:textColor="@color/text_label"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="20dp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupGender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:singleSelection="true"
                    app:chipSpacingHorizontal="8dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMale"
                        style="@style/Widget.WalkMate.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gender_male" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFemale"
                        style="@style/Widget.WalkMate.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gender_female" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAny"
                        style="@style/Widget.WalkMate.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gender_any"
                        android:checked="true" />
                </com.google.android.material.chip.ChipGroup>

                <!-- SECTION: What (Tags) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_what_tags"
                    android:textColor="@color/text_label"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="20dp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupTags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:singleSelection="false"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="8dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipRunning"
                        style="@style/Widget.WalkMate.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tag_running"
                        android:checked="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPodcast"
                        style="@style/Widget.WalkMate.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tag_podcast" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipDog"
                        style="@style/Widget.WalkMate.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tag_dog" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMeditation"
                        style="@style/Widget.WalkMate.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tag_meditation" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSlowWalk"
                        style="@style/Widget.WalkMate.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tag_slow_walk" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPhotography"
                        style="@style/Widget.WalkMate.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tag_photography" />
                </com.google.android.material.chip.ChipGroup>

                <!-- CTA: Find Match -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFindMatch"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height_large"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_gradient_orange_pill"
                    android:text="@string/find_match"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:stateListAnimator="@null"
                    app:backgroundTint="@null"
                    app:cornerRadius="999dp" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ========================================================== -->
    <!-- LAYER 5: Matching Overlay (scanning indicator)             -->
    <!-- ========================================================== -->
    <FrameLayout
        android:id="@+id/matchingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_white_pill"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:elevation="8dp">

            <!-- Pulse indicator -->
            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp">

                <View
                    android:id="@+id/pulseRingOuter"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_ring_orange" />

                <View
                    android:id="@+id/pulseRingInner"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_ring_orange" />

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_dot_orange" />
            </FrameLayout>

            <TextView
                android:id="@+id/txtScanning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- ========================================================== -->
    <!-- LAYER 6: Match Result Dialog                               -->
    <!-- ========================================================== -->
    <FrameLayout
        android:id="@+id/matchResultContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="20dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/matchResultDialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_dialog_rounded_48"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="24dp"
            android:elevation="12dp">

            <!-- Avatar -->
            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp">

                <ImageView
                    android:id="@+id/imgMatchAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Match avatar" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_avatar_border_orange" />
            </FrameLayout>

            <!-- Name -->
            <TextView
                android:id="@+id/txtMatchName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/match_name"
                android:textColor="@color/text_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Distance / rating -->
            <TextView
                android:id="@+id/txtMatchDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/match_distance"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <!-- Matched Tags -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupMatchedTags"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:chipSpacingHorizontal="8dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMatchTag1"
                    style="@style/Widget.WalkMate.Chip.Active"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tag_running"
                    android:clickable="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMatchTag2"
                    style="@style/Widget.WalkMate.Chip.Active"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tag_podcast"
                    android:clickable="false" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Time window -->
            <TextView
                android:id="@+id/txtWalkTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_time_window"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="@string/match_walk_time"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Action buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPass"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height_medium"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_button_outline_orange"
                    android:text="@string/btn_pass"
                    android:textColor="@color/orange_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:stateListAnimator="@null"
                    app:backgroundTint="@null"
                    app:cornerRadius="999dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAccept"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height_medium"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_gradient_orange_pill"
                    android:text="@string/btn_accept"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:stateListAnimator="@null"
                    app:backgroundTint="@null"
                    app:cornerRadius="999dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
