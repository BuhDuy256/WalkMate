<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Author avatar + name + date + visibility chip (owner) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.walkmate.core.designsystem.view.AvatarInitialView
                android:id="@+id/img_author_avatar"
                android:layout_width="40dp"
                android:layout_height="40dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:id="@+id/txt_author_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1F2937"
                    android:text="Author Name" />

                <TextView
                    android:id="@+id/txt_created_at"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="#9CA3AF"
                    android:text="Date" />
            </LinearLayout>

            <!-- Visibility chip — hidden in viewer variant -->
            <com.walkmate.core.designsystem.view.VisibilityChipView
                android:id="@+id/chip_visibility"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:visibility="gone" />

            <!-- Overflow menu button — hidden in viewer variant -->
            <ImageView
                android:id="@+id/btn_overflow"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_more_vert"
                android:contentDescription="More options"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Route map image — shown when showRouteMap=true AND routePreviewUrl is set -->
        <ImageView
            android:id="@+id/img_route_map"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="12dp"
            android:scaleType="centerCrop"
            android:contentDescription="Route map"
            android:visibility="gone" />

        <!-- Route map fallback label — shown when showRouteMap=true but no URL available -->
        <TextView
            android:id="@+id/txt_route_no_data"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textSize="13sp"
            android:textColor="#9CA3AF"
            android:background="#F3F2F0"
            android:visibility="gone" />

        <!-- Hotspot row -->
        <TextView
            android:id="@+id/txt_hotspot_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="13sp"
            android:textColor="#F97316"
            android:textStyle="bold"
            android:text="Hotspot" />

        <!-- Stats row — hidden when showStats=false -->
        <LinearLayout
            android:id="@+id/layout_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <com.walkmate.core.designsystem.view.WalkMateStatColumn
                android:id="@+id/stat_distance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#E5E7EB"
                android:layout_marginHorizontal="8dp" />

            <com.walkmate.core.designsystem.view.WalkMateStatColumn
                android:id="@+id/stat_duration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Companion row — hidden when showCompanion=false -->
        <LinearLayout
            android:id="@+id/layout_companion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="with "
                android:textSize="12sp"
                android:textColor="#6B7280" />

            <TextView
                android:id="@+id/txt_companion_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#374151" />
        </LinearLayout>

        <!-- Caption -->
        <TextView
            android:id="@+id/txt_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="13sp"
            android:textColor="#374151"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
