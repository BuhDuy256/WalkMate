<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_cream">

    <include layout="@layout/layout_sub_page_header" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ProgressBar
            android:id="@+id/progressWalkActivity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="visible" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvWalkActivity"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtWalkActivityEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="No posts yet.\nShare a walk session to get started!"
            android:textSize="14sp"
            android:textColor="#9CA3AF"
            android:gravity="center"
            android:paddingHorizontal="32dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtWalkActivityError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textSize="14sp"
            android:textColor="#EF4444"
            android:gravity="center"
            android:paddingHorizontal="32dp"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
