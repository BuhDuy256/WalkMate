<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/bg_white"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/handle_bar"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ── Map placeholder (top half) ── -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:background="@color/bg_map">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_tab_explore"
                    android:alpha="0.45" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/session_map_placeholder"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

            </LinearLayout>

        </FrameLayout>

        <!-- ── Partner info + actions ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Partner row: avatar + name/location -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.walkmate.core.designsystem.view.AvatarInitialView
                    android:id="@+id/avatarPartner"
                    android:layout_width="48dp"
                    android:layout_height="48dp" />

                <!-- Name + meeting point -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtPartnerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_dark"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/txtMeetingPoint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:maxLines="1"
                        android:ellipsize="end" />

                </LinearLayout>

            </LinearLayout>

            <!-- ── Divider ── -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="@color/handle_bar" />

            <!-- Meeting time -->
            <TextView
                android:id="@+id/txtMeetingTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- ── Action buttons ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp">

                <!-- Chat (outlined, muted — coming soon) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChat"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/btn_chat"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp"
                    app:strokeColor="@color/handle_bar"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="999dp" />

                <!-- Cancel Session (outlined, red) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelSession"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="2"
                    android:layout_marginStart="8dp"
                    android:text="@string/btn_cancel_session"
                    android:textColor="@color/color_danger"
                    android:textSize="14sp"
                    app:strokeColor="@color/color_danger"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="999dp" />

            </LinearLayout>

            <!-- Activation window — PENDING sessions: "I'm Here!" button with
                 auto-enable/disable based on the 10-min-before / 15-min-after window. -->
            <com.walkmate.core.designsystem.view.ActivationWindowButtonView
                android:id="@+id/activationBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone" />

            <!-- Complete Walk CTA — ACTIVE sessions, enabled after 5 min -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnComplete"
                style="@style/Widget.Material3.Button.UnelevatedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_gradient_orange_pill"
                android:text="@string/btn_complete_walk"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:cornerRadius="999dp"
                app:backgroundTint="@null" />

            <!-- Emergency Abort — ACTIVE sessions -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAbort"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/btn_abort_walk"
                android:textColor="@color/color_danger"
                android:textSize="14sp"
                android:visibility="gone"
                app:strokeColor="@color/color_danger"
                app:strokeWidth="1.5dp"
                app:cornerRadius="999dp" />

            <!-- Report Issue — ACTIVE sessions only (GAP-15) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReportIssue"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:text="Report an Issue"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
