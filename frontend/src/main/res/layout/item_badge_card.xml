<?xml version="1.0" encoding="utf-8"?>
<!--
  Badge card. Matches the Figma design:
  - Left rarity accent bar (3dp wide)
  - Top shimmer strip (3dp, earned only)
  - Name + rarity chip + lock icon row
  - Description
  - Earned date OR progress label + progress bar
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/bg_white">

    <!-- Root frame allows the accent bar and shimmer strip to be positioned absolutely -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Left rarity accent bar -->
        <View
            android:id="@+id/viewAccentBar"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp" />

        <!-- Top shimmer strip (earned state only) -->
        <View
            android:id="@+id/viewShimmerStrip"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="top"
            android:visibility="gone" />

        <!-- Card content (left-padded past the accent bar) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- Name row: name + rarity chip + lock icon -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/txtBadgeName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_dark"
                    android:letterSpacing="-0.01" />

                <TextView
                    android:id="@+id/txtBadgeRarity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.04"
                    android:paddingStart="7dp"
                    android:paddingEnd="7dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:background="@drawable/bg_rarity_chip" />

                <!-- Spacer -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Lock icon (locked badges only) -->
                <ImageView
                    android:id="@+id/viewLockIcon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_lock"
                    android:contentDescription="Locked"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Description -->
            <TextView
                android:id="@+id/txtBadgeDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/text_label"
                android:lineSpacingMultiplier="1.45"
                android:layout_marginBottom="6dp" />

            <!-- Earned date (earned state) -->
            <TextView
                android:id="@+id/txtEarnedDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:visibility="gone" />

            <!-- Progress label (locked state) -->
            <TextView
                android:id="@+id/txtProgressLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:layout_marginBottom="5dp"
                android:visibility="gone" />

            <!-- Progress bar (locked state) -->
            <ProgressBar
                android:id="@+id/progressBarBadge"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:max="100"
                android:progress="0"
                android:progressBackgroundTint="#F3F2F0"
                android:visibility="gone" />

        </LinearLayout>

    </FrameLayout>

</androidx.cardview.widget.CardView>
