<?xml version="1.0" encoding="utf-8" ?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream"
>

    <!--
        NavHostFragment fills the entire screen, including behind the nav bar.
        This allows the Explore map to render edge-to-edge, while Matches and
        Profile fragments add their own bottom padding via WindowInsetsCompat.

        app:defaultNavHost="true" ensures this host intercepts the system Back
        button so the NavController handles back-stack pops, not the Activity.
    -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph" />

    <!--
        Bottom Navigation Bar.
        - background matches the global bg_cream so it blends with the system nav bar.
        - itemActiveIndicatorColor is transparent to keep the visual affordance minimal:
          only icon + text tint change to orange_end on selection.
        - elevation creates a subtle shadow separating the bar from content.
    -->
    <!-- Full-screen overlay container for manual fragment transactions (e.g. EditProfile, SessionHistory) -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/bg_cream"
        app:elevation="8dp"
        app:itemIconTint="@color/nav_icon_color"
        app:itemTextColor="@color/nav_icon_color"
        app:itemActiveIndicatorStyle="@style/Theme.WalkMate.BottomNavIndicator"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_bottom_nav"
    />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
