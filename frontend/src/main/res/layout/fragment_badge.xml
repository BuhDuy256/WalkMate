<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_cream">

    <!-- ── Sticky header ──────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bg_white"
        android:elevation="4dp">

        <include layout="@layout/layout_sub_page_header" />

        <!-- Filter tabs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/bg_white">

            <TextView
                android:id="@+id/tabAll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="All"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textSize="13sp"
                android:textColor="@color/orange_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabEarned"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Earned"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textSize="13sp"
                android:textColor="@color/text_muted" />

            <TextView
                android:id="@+id/tabLocked"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Locked"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textSize="13sp"
                android:textColor="@color/text_muted" />

        </LinearLayout>

        <!-- 1dp bottom border under tabs -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F3F2F0" />

    </LinearLayout>

    <!-- ── Progress bar (loading) ─────────────────────────────────────────── -->
    <ProgressBar
        android:id="@+id/progressBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="32dp"
        android:visibility="gone" />

    <!-- ── Empty state ────────────────────────────────────────────────────── -->
    <TextView
        android:id="@+id/txtBadgeEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="32dp"
        android:gravity="center"
        android:textSize="14sp"
        android:textColor="@color/text_muted"
        android:lineSpacingMultiplier="1.4"
        android:visibility="gone" />

    <!-- ── Badge list ─────────────────────────────────────────────────────── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBadges"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="16dp"
        android:paddingBottom="96dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:clipToPadding="false"
        android:visibility="gone" />

</LinearLayout>
