<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="24dp"
        android:paddingBottom="40dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:fontFamily="sans-serif-black"
            android:text="@string/forgot_password_new_password_title"
            android:textColor="@color/text_dark"
            android:textSize="24sp" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/forgot_password_new_password_subtitle"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <!-- New password field -->
        <com.walkmate.core.designsystem.view.WalkMateInputField
            android:id="@+id/field_new_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            app:wm_hint="@string/forgot_password_new_password_hint"
            app:wm_icon="@drawable/ic_lock"
            app:wm_label="New Password"
            app:wm_passwordToggle="true" />

        <!-- Confirm password field -->
        <com.walkmate.core.designsystem.view.WalkMateInputField
            android:id="@+id/field_confirm_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:wm_hint="@string/forgot_password_confirm_password_hint"
            app:wm_icon="@drawable/ic_lock"
            app:wm_label="Confirm Password"
            app:wm_passwordToggle="true" />

        <!-- Reset button -->
        <com.walkmate.core.designsystem.view.WalkMateButton
            android:id="@+id/btn_reset_password"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="28dp"
            app:wm_buttonStyle="filled"
            app:wm_text="@string/forgot_password_reset_btn" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
