<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/bg_white"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/handle_bar"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Zone 1: Shared header — status badge + countdown -->
        <com.walkmate.core.designsystem.view.MatchCardHeaderView
            android:id="@+id/cardHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Zone 2: Identity — hotspot name + meta chips -->
        <TextView
            android:id="@+id/txtHotspotName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_dark"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDuration"
                style="@style/Widget.WalkMate.Chip.Active"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAgeRange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:clickable="false"
                android:focusable="false"
                android:textSize="13sp"
                android:textColor="@color/text_label"
                app:chipBackgroundColor="@color/bg_tag_inactive"
                app:chipCornerRadius="999dp"
                app:chipEndPadding="12dp"
                app:chipIconVisible="false"
                app:chipMinHeight="36dp"
                app:chipStartPadding="12dp"
                app:chipStrokeWidth="0dp"
                app:checkedIconVisible="false" />

        </LinearLayout>

        <!-- Zone 2 → 3 divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="@color/handle_bar" />

        <!-- Zone 3: Time window -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TIME WINDOW"
            android:textColor="@color/text_label"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <TextView
            android:id="@+id/txtTimeWindow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_time_window"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textColor="@color/text_dark"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Zone 4: Tags -->
        <com.walkmate.core.designsystem.view.TagChipGroup
            android:id="@+id/chipGroupTags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:chipSpacingHorizontal="6dp"
            app:chipSpacingVertical="4dp" />

        <!-- Zone 5: Primary CTA — "View Proposal" (MATCHING) or hidden (OPEN) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFindMatch"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:text="@string/find_match"
            android:textSize="14sp"
            android:visibility="gone"
            app:cornerRadius="999dp" />

        <!-- Zone 5: Secondary — Cancel Intent (OPEN, not expired) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelIntent"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/btn_cancel_intent"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            app:strokeColor="@color/handle_bar"
            app:strokeWidth="1.5dp"
            app:cornerRadius="999dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
