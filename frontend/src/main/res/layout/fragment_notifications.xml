<?xml version="1.0" encoding="utf-8"?>
<!--
    Notification Center screen
    IDs required by NotificationFragment.java (via layout_sub_page_header):
      btnSubPageBack, txtSubPageTitle, btnHeaderAction,
      progress_notifications, rv_notifications,
      txt_notifications_empty, txt_notifications_error
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream"
    android:orientation="vertical"
    tools:context=".ui.notification.NotificationFragment">

    <include layout="@layout/layout_sub_page_header" />

    <!-- ── Content area ────────────────────────────────────────────────────── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Loading spinner -->
        <ProgressBar
            android:id="@+id/progress_notifications"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/orange_primary"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Notification list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_notifications"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="16dp"
            android:paddingBottom="24dp"
            android:paddingHorizontal="@dimen/screen_padding_horizontal"
            android:overScrollMode="never"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_notification" />

        <!-- Empty state -->
        <TextView
            android:id="@+id/txt_notifications_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/notification_empty"
            android:textColor="@color/text_muted"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.4"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Error state -->
        <TextView
            android:id="@+id/txt_notifications_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/notification_error"
            android:textColor="@color/color_danger"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.4"
            android:visibility="gone"
            tools:visibility="visible" />

    </FrameLayout>

</LinearLayout>
