<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ── Main auth content ──────────────────────────────────────────────── -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/auth_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_cream"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="64dp"
            android:paddingBottom="40dp">

            <!-- ── BRAND ─────────────────────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    app:cardBackgroundColor="@color/orange_primary"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="6dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="18dp"
                        android:src="@drawable/logo"
                        app:tint="@color/white" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-black"
                    android:text="WalkMate"
                    android:textColor="@color/text_dark"
                    android:textSize="30sp" />

            </LinearLayout>

            <!-- ── FIELDS ─────────────────────────────────────────────────────────── -->
            <com.walkmate.core.designsystem.view.WalkMateInputField
                android:id="@+id/field_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                app:wm_hint="hello@example.com"
                app:wm_icon="@drawable/ic_mail"
                app:wm_inputType="textEmailAddress"
                app:wm_label="Email Address" />

            <com.walkmate.core.designsystem.view.WalkMateInputField
                android:id="@+id/field_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:wm_hint="Enter your password"
                app:wm_icon="@drawable/ic_lock"
                app:wm_label="Password"
                app:wm_passwordToggle="true" />

            <TextView
                android:id="@+id/tv_forgot_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:focusable="true"
                android:text="Forgot password?"
                android:textColor="@color/orange_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- ── PRIMARY CTA ──────────────────────────────────────────────────── -->
            <com.walkmate.core.designsystem.view.WalkMateButton
                android:id="@+id/btn_signin_action"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="28dp"
                app:wm_buttonStyle="filled"
                app:wm_text="Sign In" />

            <!-- ── DIVIDER ────────────────────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/bg_tag_inactive" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:text="or continue with"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/bg_tag_inactive" />

            </LinearLayout>

            <!-- ── SOCIAL LOGIN ───────────────────────────────────────────────────── -->
            <com.walkmate.core.designsystem.view.GoogleSignInButton
                android:id="@+id/btn_google_signin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp" />



            <!-- ── FOOTER LINK ────────────────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="New here? "
                    android:textColor="@color/text_muted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_create_account"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="Create an account"
                    android:textColor="@color/orange_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>



</FrameLayout>
