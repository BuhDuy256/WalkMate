<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/matchResultContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/matchResultDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_dialog_rounded_48"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="24dp"
        android:elevation="12dp">

        <!-- Avatar -->
        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp">

            <ImageView
                android:id="@+id/imgMatchAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Match avatar" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_avatar_border_orange" />
        </FrameLayout>

        <!-- Name -->
        <TextView
            android:id="@+id/txtMatchName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/match_name"
            android:textColor="@color/text_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Distance / rating -->
        <TextView
            android:id="@+id/txtMatchDistance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/match_distance"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <!-- Matched Tags -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupMatchedTags"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:chipSpacingHorizontal="8dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMatchTag1"
                style="@style/Widget.WalkMate.Chip.Active"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tag_running"
                android:clickable="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMatchTag2"
                style="@style/Widget.WalkMate.Chip.Active"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tag_podcast"
                android:clickable="false" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Time window -->
        <TextView
            android:id="@+id/txtWalkTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_time_window"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="@string/match_walk_time"
            android:textColor="@color/text_dark"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPass"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height_medium"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_button_outline_orange"
                android:text="@string/btn_pass"
                android:textColor="@color/orange_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:stateListAnimator="@null"
                app:backgroundTint="@null"
                app:cornerRadius="999dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAccept"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height_medium"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_gradient_orange_pill"
                android:text="@string/btn_accept"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:stateListAnimator="@null"
                app:backgroundTint="@null"
                app:cornerRadius="999dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
