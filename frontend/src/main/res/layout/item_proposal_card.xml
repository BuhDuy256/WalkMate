<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/bg_white"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/handle_bar"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ── Partner info row ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.walkmate.core.designsystem.view.AvatarInitialView
                android:id="@+id/avatarPartner"
                android:layout_width="52dp"
                android:layout_height="52dp" />

            <!-- Name / Age / Trust score -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <!-- Name + Age -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/txtName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_dark"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/txtAge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />

                </LinearLayout>

                <!-- Trust score -->
                <TextView
                    android:id="@+id/txtTrustScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Countdown timer (top-right; proposal 5-minute TTL) -->
            <com.walkmate.core.designsystem.view.CountdownTimerView
                android:id="@+id/countdownTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="12sp"
                app:wm_urgentThresholdSec="60"
                app:wm_urgentColor="@color/color_danger"
                app:wm_normalColor="@color/text_muted" />

        </LinearLayout>

        <!-- ── Divider ── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="@color/handle_bar" />

        <!-- ── Common time window ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/proposal_common_time"
            android:textColor="@color/text_label"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <TextView
            android:id="@+id/txtTimeWindow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@color/bg_warm_light"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textColor="@color/text_dark"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- ── Common interests ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/proposal_common_interests"
            android:textColor="@color/text_label"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <com.walkmate.core.designsystem.view.TagChipGroup
            android:id="@+id/chipGroupTags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:chipSpacingHorizontal="6dp"
            app:chipSpacingVertical="4dp" />

        <!-- ── Action buttons ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp">

            <!-- Pass (outlined, muted) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPass"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/btn_pass"
                android:textColor="@color/text_muted"
                android:textSize="14sp"
                app:strokeColor="@color/handle_bar"
                app:strokeWidth="1.5dp"
                app:cornerRadius="999dp" />

            <!-- Accept (orange gradient) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAccept"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="2"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_gradient_orange_pill"
                android:text="@string/btn_accept"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:cornerRadius="999dp"
                app:elevation="0dp" />

        </LinearLayout>

        <!-- Waiting overlay: shown when I accepted but partner has not (Case A) -->
        <TextView
            android:id="@+id/txtWaitingOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/proposal_waiting_partner"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Cancel (full-width, danger text — destructive secondary action) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelProposal"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:text="@string/btn_cancel_proposal"
            android:textColor="@color/color_danger"
            android:textSize="13sp"
            app:cornerRadius="999dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
