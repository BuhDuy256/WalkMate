<?xml version="1.0" encoding="utf-8"?>
<!-- Shows only a bottom border by clipping top/left/right edges outward -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:top="-2dp"
        android:left="-2dp"
        android:right="-2dp">
        <shape android:shape="rectangle">
            <stroke android:width="1.5dp" android:color="#FFD6D3D1" />
        </shape>
    </item>
</layer-list>
