<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/profile_chip_red_checked_start"
                android:endColor="@color/profile_chip_red_checked_end" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/profile_chip_red_unchecked" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
