<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base App Theme -->
    <style name="Theme.WalkMate" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/bg_cream</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorPrimary">@color/orange_end</item>
        <item name="colorPrimaryVariant">@color/orange_start</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/bg_white</item>
        <item name="colorOnSurface">@color/text_dark</item>
    </style>

    <!-- Chip: Inactive state (default) — matches #F5EDE4 bg, #7A6657 text -->
    <style name="Widget.WalkMate.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg_color_selector</item>
        <item name="android:textColor">@color/chip_text_color_selector</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="chipCornerRadius">999dp</item>
        <item name="chipMinHeight">40dp</item>
        <item name="chipStartPadding">16dp</item>
        <item name="chipEndPadding">16dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipIconVisible">false</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

    <!-- Chip: Always active style (for match result tags) -->
    <style name="Widget.WalkMate.Chip.Active" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/orange_end</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="chipCornerRadius">999dp</item>
        <item name="chipMinHeight">32dp</item>
        <item name="chipStartPadding">12dp</item>
        <item name="chipEndPadding">12dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipIconVisible">false</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

</resources>
