<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ═══════════════════════════════════════════════════════════════════════
         WalkMateInputField
         Label + EditText + optional password toggle + inline error display.
         ═══════════════════════════════════════════════════════════════════════ -->
    <declare-styleable name="WalkMateInputField">
        <!-- Label text shown above the input field -->
        <attr name="wm_label" format="string" />
        <!-- Placeholder hint inside the EditText -->
        <attr name="wm_hint" format="string" />
        <!-- Drawable icon placed at the start of the EditText -->
        <attr name="wm_icon" format="reference" />
        <!-- android:inputType forwarded to the inner EditText.
             Mirrors the standard inputType flags so XML values like
             textEmailAddress / textPersonName / textPassword work. -->
        <attr name="wm_inputType" format="flags">
            <flag name="none"                value="0x00000000" />
            <flag name="text"                value="0x00000001" />
            <flag name="textCapCharacters"   value="0x00001001" />
            <flag name="textCapWords"        value="0x00002001" />
            <flag name="textCapSentences"    value="0x00004001" />
            <flag name="textAutoCorrect"     value="0x00008001" />
            <flag name="textAutoComplete"    value="0x00010001" />
            <flag name="textMultiLine"       value="0x00020001" />
            <flag name="textNoSuggestions"   value="0x00080001" />
            <flag name="textUri"             value="0x00000011" />
            <flag name="textEmailAddress"    value="0x00000021" />
            <flag name="textEmailSubject"    value="0x00000031" />
            <flag name="textShortMessage"    value="0x00000041" />
            <flag name="textLongMessage"     value="0x00000051" />
            <flag name="textPersonName"      value="0x00000061" />
            <flag name="textPostalAddress"   value="0x00000071" />
            <flag name="textPassword"        value="0x00000081" />
            <flag name="textVisiblePassword" value="0x00000091" />
            <flag name="textWebEditText"     value="0x000000a1" />
            <flag name="textFilter"          value="0x000000b1" />
            <flag name="textPhonetic"        value="0x000000c1" />
            <flag name="number"              value="0x00000002" />
            <flag name="numberSigned"        value="0x00001002" />
            <flag name="numberDecimal"       value="0x00002002" />
            <flag name="numberPassword"      value="0x00000012" />
            <flag name="phone"               value="0x00000003" />
            <flag name="datetime"            value="0x00000004" />
            <flag name="date"                value="0x00000014" />
            <flag name="time"                value="0x00000024" />
        </attr>
        <!-- Show password visibility toggle button (for password fields) -->
        <attr name="wm_passwordToggle" format="boolean" />
    </declare-styleable>

    <!-- ═══════════════════════════════════════════════════════════════════════
         WalkMateButton
         Orange pill button with FILLED (gradient) or OUTLINED (stroke) variant.
         Supports setLoading(boolean) to show an indeterminate ProgressBar.
         ═══════════════════════════════════════════════════════════════════════ -->
    <declare-styleable name="WalkMateButton">
        <!-- Visual variant: filled = gradient orange pill; outlined = stroke only -->
        <attr name="wm_buttonStyle" format="enum">
            <enum name="filled" value="0" />
            <enum name="outlined" value="1" />
        </attr>
        <!-- Button label text -->
        <attr name="wm_text" format="string" />
    </declare-styleable>

    <!-- ═══════════════════════════════════════════════════════════════════════
         AvatarInitialView
         Circle avatar showing photo (Glide) with fallback to first-letter initial.
         Optionally renders a green online-status dot at the bottom-right.
         ═══════════════════════════════════════════════════════════════════════ -->
    <declare-styleable name="AvatarInitialView">
        <!-- Static name used to derive the fallback initial letter -->
        <attr name="wm_avatarName" format="string" />
        <!-- Show the green online-status indicator dot -->
        <attr name="wm_showOnlineStatus" format="boolean" />
        <!-- Font size (sp) of the initial letter — defaults to 20sp -->
        <attr name="wm_initialTextSize" format="dimension" />
    </declare-styleable>

    <!-- ═══════════════════════════════════════════════════════════════════════
         WalkMateStatColumn
         Vertical icon/emoji → value (bold) → label (muted) stat column.
         Used in Home stats cards, Profile stats row, Tracking screen columns.
         ═══════════════════════════════════════════════════════════════════════ -->
    <declare-styleable name="WalkMateStatColumn">
        <!-- Static value text (use bind() at runtime for ViewModel-driven values) -->
        <attr name="wm_statValue" format="string" />
        <!-- Static label text -->
        <attr name="wm_statLabel" format="string" />
        <!-- Drawable icon above the value (mutually exclusive with wm_statEmoji) -->
        <attr name="wm_statIcon" format="reference" />
        <!-- Emoji string above the value (mutually exclusive with wm_statIcon) -->
        <attr name="wm_statEmoji" format="string" />
        <!-- Font size (sp) for the value text — defaults to 18sp -->
        <attr name="wm_statValueSize" format="dimension" />
    </declare-styleable>

    <!-- ═══════════════════════════════════════════════════════════════════════
         TagChipGroup
         ChipGroup subclass that creates chips from List<String> with a single
         setTags() call. Handles all removeAllViews() + programmatic chip
         creation internally. Style is controlled by wm_chipStyle.
         ═══════════════════════════════════════════════════════════════════════ -->
    <declare-styleable name="TagChipGroup">
        <!-- Chip visual style: display = non-clickable orange (default); selectable = toggleable -->
        <attr name="wm_chipStyle" format="enum">
            <enum name="display" value="0" />
            <enum name="selectable" value="1" />
        </attr>
    </declare-styleable>

    <!-- ═══════════════════════════════════════════════════════════════════════
         OtpInputView
         Row of 6 single-digit EditText boxes with auto-focus-advance and
         backspace-to-previous navigation. Fully programmatic — no custom XML
         attributes. Use getOtp() / clear() / setEnabled() at runtime.
         ═══════════════════════════════════════════════════════════════════════ -->
    <declare-styleable name="OtpInputView">
        <!-- No XML-configurable attributes; layout is generated programmatically. -->
    </declare-styleable>

    <!-- ═══════════════════════════════════════════════════════════════════════
         WalkMateCardHeader
         Single-row card header: [emoji] [title ──── spacer ──── ] [chevron?]
         Replaces the layout_weight=1 spacer antipattern with a flat
         ConstraintLayout (start-constrained emoji + 0dp title + end chevron).
         ═══════════════════════════════════════════════════════════════════════ -->
    <declare-styleable name="WalkMateCardHeader">
        <!-- Emoji character (or short text) shown at the start of the header -->
        <attr name="wm_headerEmoji" format="string" />
        <!-- Header title text -->
        <attr name="wm_headerTitle" format="string" />
        <!-- Show the trailing chevron (right-arrow) — set false for non-tappable headers -->
        <attr name="wm_navigable" format="boolean" />
    </declare-styleable>


    <!-- ═══════════════════════════════════════════════════════════════════════
         CountdownTimerView
         Self-ticking MM:SS countdown text view. Switches colour to urgentColor
         when the remaining time drops below urgentThresholdSec.
         ═══════════════════════════════════════════════════════════════════════ -->
    <declare-styleable name="CountdownTimerView">
        <!-- Seconds remaining below which the text colour switches to wm_urgentColor -->
        <attr name="wm_urgentThresholdSec" format="integer" />
        <!-- Text colour when remaining time is below the urgent threshold -->
        <attr name="wm_urgentColor"        format="color"   />
        <!-- Text colour when remaining time is above the urgent threshold -->
        <attr name="wm_normalColor"        format="color"   />
    </declare-styleable>

    <!-- ═══════════════════════════════════════════════════════════════════════
         MatchCardHeaderView
         Shared header row for all Matches sub-fragment item cards.
         Left: status badge chip. Right: optional countdown timer.
         Used by item_finding_card, item_proposal_card, item_session_card.
         ═══════════════════════════════════════════════════════════════════════ -->
    <declare-styleable name="MatchCardHeaderView">
        <!-- Status label text (e.g. "Searching…", "Matched 🔒", "Decide Now") -->
        <attr name="wm_statusLabel" format="string" />
        <!-- Visual style preset controlling badge background and text colour -->
        <attr name="wm_statusStyle" format="enum">
            <enum name="open"             value="0" />
            <enum name="matching"         value="1" />
            <enum name="proposal_pending" value="2" />
            <enum name="proposal_waiting" value="3" />
            <enum name="session_pending"  value="4" />
            <enum name="session_active"   value="5" />
        </attr>
        <!-- Whether the countdown timer is visible at inflation time -->
        <attr name="wm_showCountdown" format="boolean" />
    </declare-styleable>

    <!-- ═══════════════════════════════════════════════════════════════════════
         ActivationWindowButtonView
         Vertical view with a status label and a WalkMateButton that enables
         itself only while the session activation window is open
         (scheduledStart − 10 min to scheduledStart + 15 min, per S-3).
         ═══════════════════════════════════════════════════════════════════════ -->
    <declare-styleable name="ActivationWindowButtonView">
        <!-- Button / status label text when the window is open -->
        <attr name="wm_arriveLabel"  format="string" />
        <!-- Status label text when the window has not yet opened -->
        <attr name="wm_waitingLabel" format="string" />
    </declare-styleable>

</resources>
